<%- include('./partials/header',{acc:user,cart:0,active:''}) %>

<% if(success.length>0){ %>
<div id="flashMessage"
    class="fixed top-20 left-1/2 -translate-x-1/2 bg-blue-500 text-white px-5 py-3 rounded-lg shadow-lg z-50">
    <%= success %>
</div>
<% } %>

<div class="min-h-screen bg-gray-100 py-6">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex flex-col lg:flex-row gap-6">

            <!-- Sidebar -->
            <aside class="w-full lg:w-64">

                <div class="bg-white rounded-2xl shadow-md p-5">

                    <h3 class="font-bold text-lg mb-4">Admin Menu</h3>

                    <div class="flex flex-col gap-3">

                        <a href="/shop"
                            class="px-4 py-3 rounded-lg hover:bg-blue-50 hover:text-blue-600 transition">
                            All Products
                        </a>

                        <a href="/products/create"
                            class="px-4 py-3 rounded-lg bg-blue-50 text-blue-600 font-semibold">
                            Create New Product
                        </a>

                    </div>

                </div>

            </aside>

            <!-- Main Form -->
            <main class="flex-1 bg-white rounded-2xl shadow-md p-6 sm:p-8">

                <h2 class="text-2xl md:text-3xl font-bold mb-8">
                    Create New Product
                </h2>

                <form autocomplete="off"
                    action="/products/create"
                    method="post"
                    enctype="multipart/form-data"
                    class="space-y-8">

                    <!-- Product Details -->
                    <section>

                        <h3 class="text-xl font-semibold mb-5">
                            Product Details
                        </h3>

                        <!-- Image Upload -->
                        <div class="mb-6">

                            <label class="block mb-3 font-medium">
                                Product Image
                            </label>

                            <div class="border-2 border-dashed border-gray-300 rounded-xl p-5">

                                <input
                                    name="image"
                                    type="file"
                                    class="w-full text-sm text-gray-600
                                    file:mr-4
                                    file:py-2
                                    file:px-4
                                    file:rounded-lg
                                    file:border-0
                                    file:bg-blue-500
                                    file:text-white
                                    hover:file:bg-blue-600"/>

                            </div>

                        </div>

                        <!-- Inputs -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                            <input
                                name="name"
                                type="text"
                                placeholder="Product Name"
                                class="border p-3 rounded-xl w-full focus:ring-2 focus:ring-blue-400 outline-none">

                            <input
                                name="price"
                                type="text"
                                placeholder="Product Price"
                                class="border p-3 rounded-xl w-full focus:ring-2 focus:ring-blue-400 outline-none">

                            <input
                                name="discount"
                                type="text"
                                placeholder="Discount Price"
                                class="border p-3 rounded-xl w-full focus:ring-2 focus:ring-blue-400 outline-none">

                            <input
                                name="stock"
                                type="number"
                                placeholder="Stock Amount"
                                class="border p-3 rounded-xl w-full focus:ring-2 focus:ring-blue-400 outline-none">

                            <input
                                name="rating"
                                type="text"
                                placeholder="Rating (for function purpose)"
                                class="border p-3 rounded-xl w-full md:col-span-2 focus:ring-2 focus:ring-blue-400 outline-none">

                        </div>

                    </section>

                    <!-- Panel Details -->
                    <section>

                        <h3 class="text-xl font-semibold mb-5">
                            Panel Details
                        </h3>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">

                            <div class="bg-gray-50 rounded-xl p-4 text-center">

                                <input
                                    name="bgcolor"
                                    type="color"
                                    class="w-16 h-16 rounded-lg border cursor-pointer mx-auto">

                                <label class="block mt-3 text-sm font-medium">
                                    Background Color
                                </label>

                            </div>

                            <div class="bg-gray-50 rounded-xl p-4 text-center">

                                <input
                                    name="panelcolor"
                                    type="color"
                                    class="w-16 h-16 rounded-lg border cursor-pointer mx-auto">

                                <label class="block mt-3 text-sm font-medium">
                                    Panel Color
                                </label>

                            </div>

                            <div class="bg-gray-50 rounded-xl p-4 text-center">

                                <input
                                    name="textcolor"
                                    type="color"
                                    class="w-16 h-16 rounded-lg border cursor-pointer mx-auto">

                                <label class="block mt-3 text-sm font-medium">
                                    Text Color
                                </label>

                            </div>

                        </div>

                    </section>

                    <!-- Submit -->
                    <button
                        class="w-full sm:w-auto bg-blue-500 hover:bg-blue-600 text-white font-semibold px-8 py-3 rounded-xl shadow-md hover:shadow-xl transition-all duration-300">

                        Create New Product

                    </button>

                </form>

            </main>

        </div>

    </div>

</div>

<script>
setTimeout(() => {
    const flash = document.getElementById("flashMessage");

    if (flash) {
        flash.style.transition = "opacity 0.5s ease";
        flash.style.opacity = "0";

        setTimeout(() => flash.remove(), 500);
    }
}, 3000);
</script>

<%- include('./partials/footer') %>