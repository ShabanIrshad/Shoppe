<% var loggedIn = typeof loggedIn != 'undefined' ? loggedIn : true %>

<% if(loggedIn){ %>

<footer class="bg-gray-50 border-t border-gray-200 mt-10">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <div class="bg-white border border-gray-200 rounded-2xl shadow-md p-6 lg:p-8">

            <!-- Responsive Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 items-start">

                <!-- Brand Section -->
                <div class="md:col-span-2 lg:col-span-2">

                    <h3 class="text-3xl font-bold text-blue-500">Shoppe</h3>

                    <div class="border-b-4 border-blue-400 py-5 mb-5">
                        <p class="text-gray-600 leading-7">
                            Discover a carefully curated collection of men's accessories designed
                            to add style, confidence, and personality to every look. From classic
                            watches, wallets, belts, and sunglasses to bags, bracelets, caps, and
                            other everyday essentials.
                        </p>
                    </div>

                    <!-- Newsletter -->
                    <form method="post" action="/subscribe"
                        class="flex flex-col md:flex-row gap-3">

                        <input
                            type="text"
                            name="subscribe"
                            placeholder="Subscribe Newsletter..."
                            class="flex-1 px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-400 outline-none">

                        <button
                            class="bg-black text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 transition w-full md:w-auto">
                            Subscribe
                        </button>

                    </form>

                    <!-- Social Icons -->
                    <div class="flex gap-4 mt-6">

                        <a href="/shop">
                            <img class="w-7 h-7 hover:scale-110 transition"
                                src="/images/a.png" alt="Instagram">
                        </a>

                        <a href="https://www.linkedin.com/in/mohd-shaban-ab2417146/"
                            target="_blank">
                            <img class="w-7 h-7 hover:scale-110 transition"
                                src="/images/b.png" alt="LinkedIn">
                        </a>

                        <a href="https://github.com/ShabanIrshad"
                            target="_blank">
                            <img class="w-7 h-7 hover:scale-110 transition"
                                src="/images/c.png" alt="GitHub">
                        </a>

                    </div>

                </div>

                <!-- Quick Links -->
                <div>

                    <h3 class="text-xl font-bold mb-4">Quick Links</h3>

                    <div class="flex flex-col gap-2 text-gray-700 text-sm md:text-base">

                        <a href="/account" class="hover:text-blue-500 transition">Account</a>

                        <a href="/cart" class="hover:text-blue-500 transition">Go to Cart</a>

                        <a href="/shop" class="hover:text-blue-500 transition">Go to Shop</a>

                        <a href="/shop" class="hover:text-blue-500 transition">Contact Us</a>

                        <a href="/shop" class="hover:text-blue-500 transition">Blog</a>

                        <a href="/shop" class="hover:text-blue-500 transition">Projects</a>

                    </div>

                </div>

                <!-- Products -->
                <div>

                    <h3 class="text-xl font-bold mb-4">All Products</h3>

                    <div class="flex flex-col gap-2 text-gray-700 text-sm md:text-base">

                        <p>Watches</p>
                        <p>Wallets</p>
                        <p>Belts</p>
                        <p>Sunglasses</p>
                        <p>Bags</p>
                        <p>Caps</p>
                        <p>Bracelets</p>

                    </div>

                </div>

            </div>

        </div>

        <!-- Copyright -->
        <div class="mt-6 text-center text-gray-600 text-sm">
            Created with Love ❤️ by <span class="font-semibold">SHABAN</span>
        </div>

    </div>

</footer>

<% } %>

</body>
</html>