<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/icon.png" type="image/x-icon">
    <title>Shoppe</title>

    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="font-['helvetica_now_display'] bg-gray-50">

<% var loggedIn = typeof loggedIn != 'undefined' ? loggedIn : true %>

<% if(loggedIn){ %>

<nav class="w-full bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex justify-between items-center h-16">

            <!-- Logo -->
            <a href="/shop">
                <h3 class="text-3xl font-bold text-blue-500">Shoppe</h3>
            </a>

            <!-- Desktop Menu -->
            <div class="hidden md:flex items-center gap-6">

                <a href="/cart" class="relative flex items-center">
                    <img src="/images/cart.png" class="w-6 h-6" alt="Cart"/>

                    <% if(cart > 0){ %>
                    <span class="absolute -top-2 -right-2 bg-green-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
                        <%= cart %>
                    </span>
                    <% } %>
                </a>

                <a href="/shop"
                   class="<%= (active=='shop') ? 'font-semibold text-black border-b-2 border-blue-500 pb-1' : 'text-gray-700 hover:text-blue-500' %>">
                    Shop
                </a>

                <a href="/cart"
                   class="<%= (active=='cart') ? 'font-semibold text-black border-b-2 border-blue-500 pb-1' : 'text-gray-700 hover:text-blue-500' %>">
                    Cart
                </a>

                <a href="/account"
                   class="<%= (active=='account') ? 'font-semibold text-black border-b-2 border-blue-500 pb-1' : 'text-gray-700 hover:text-blue-500' %>">
                    My Account
                </a>

                <a href="/users/logout"
                   class="text-red-500 hover:text-red-700">
                    Logout
                </a>

                <div class="px-3 py-2 bg-red-100 rounded-lg text-sm font-medium">
                    <%= acc.name %>
                </div>

            </div>

            <!-- Mobile Button -->
            <button id="menuBtn" class="md:hidden text-2xl">
                <i class="ri-menu-line"></i>
            </button>

        </div>

        <!-- Mobile Menu -->
        <div id="mobileMenu" class="hidden md:hidden pb-4 border-t border-gray-100">

            <div class="flex flex-col gap-3 pt-4">

                <a href="/shop"
                   class="px-3 py-2 rounded-lg <%= (active=='shop') ? 'bg-blue-50 text-blue-600 font-semibold' : 'hover:bg-gray-100' %>">
                    Shop
                </a>

                <a href="/cart"
                   class="flex justify-between items-center px-3 py-2 rounded-lg <%= (active=='cart') ? 'bg-blue-50 text-blue-600 font-semibold' : 'hover:bg-gray-100' %>">
                    Cart

                    <% if(cart>0){ %>
                    <span class="bg-green-600 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center">
                        <%= cart %>
                    </span>
                    <% } %>

                </a>

                <a href="/account"
                   class="px-3 py-2 rounded-lg <%= (active=='account') ? 'bg-blue-50 text-blue-600 font-semibold' : 'hover:bg-gray-100' %>">
                    My Account
                </a>

                <div class="px-3 py-2 bg-red-100 rounded-lg text-sm font-medium">
                    <%= acc.name %>
                </div>

                <a href="/users/logout"
                   class="px-3 py-2 rounded-lg text-red-600 hover:bg-red-50">
                    Logout
                </a>

            </div>

        </div>

    </div>

</nav>

<% } %>

<script>
const menuBtn = document.getElementById("menuBtn");
const mobileMenu = document.getElementById("mobileMenu");

if(menuBtn){
    menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
    });
}
</script>