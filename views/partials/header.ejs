<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/icon.png" type="image/x-icon">
    <title>Shoppe</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="font-['helvetica_now_display']">
   
        
        <% var loggedIn=typeof loggedIn !='undefined'?loggedIn:true %>
        <% if(loggedIn){ %>
            <nav class="w-full flex justify-between px-5 py-3">
                <h3 class="text-3xl text-blue-400 font-bold">Shoppe</h3>
                <div class="flex items-center gap-5">
                    <% if(cart>0){ %>
                        <a class="flex items-center "><img src="/images/cart.png" class="w-[20px] h-[20px]" alt="image" /><p class=" flex items-center justify-center text-sm <%= cart==0?'':'bg-green-700' %> text-white p-1 rounded-[50%] text-center pt-1 w-[20px] h-[20px]"><%= (cart==0)?'':(cart) %></p></a>
                    <% } %>
                    
                    <a class="<%= (active=='shop')?'font-bold underline shadow-md p-2 rounded-md':'' %>" href="/shop">Shop</a>
                    <a class="<%= (active=='cart')?'font-bold underline shadow-md p2 rounded-md':'' %>" href="/cart">Cart</a>
                    <a class="<%= (active=='account')?'font-bold underline shadow-md p-2 rounded-md':'' %>" href="/account">My Account</a>
                    <a href="/users/logout" class="text-red-600">Logout</a>
                    <a class="p-2 bg-red-100"><%=acc.name%></a>
                </div>
            </nav>
        <% }  %>
       
    