<%- include('./partials/header',{active:'',cart:0}) %>

<% if(error.length>0){ %>
<div id="flashMessage"
    class="fixed top-20 left-1/2 -translate-x-1/2 bg-red-500 text-white px-5 py-3 rounded-lg shadow-lg z-50">
    <%= error %>
</div>
<% } %>

<div class="min-h-screen bg-gray-100 flex items-center py-8">

    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 lg:grid-cols-2 overflow-hidden rounded-3xl shadow-xl bg-white">

            <!-- Signup Section -->
            <div class="p-8 sm:p-10 lg:p-14 bg-white">

                <h3 class="text-3xl sm:text-4xl font-light leading-tight">
                    Welcome to
                    <span class="text-blue-500 font-semibold">Shoppe</span>
                </h3>

                <h4 class="text-lg sm:text-2xl text-gray-600 mt-2 mb-8">
                    Create your account
                </h4>

                <form autocomplete="off"
                    action="/users/register"
                    method="post"
                    class="space-y-4">

                    <input
                        class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                        type="text"
                        placeholder="Full Name"
                        name="name">

                    <input
                        class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                        type="email"
                        placeholder="Email"
                        name="email">

                    <input
                        class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                        type="password"
                        placeholder="Password"
                        name="password">

                    <button
                        class="w-full sm:w-auto px-8 py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-full shadow-md hover:shadow-xl transition-all duration-300">

                        Create My Account

                    </button>

                </form>

            </div>

            <!-- Login Section -->
            <div class="bg-gray-100 p-8 sm:p-10 lg:p-14 flex items-center">

                <div class="w-full max-w-md mx-auto">

                    <h4 class="text-2xl sm:text-3xl text-center font-semibold mb-8">
                        Login Your Account
                    </h4>

                    <form autocomplete="off"
                        action="/users/login"
                        method="post"
                        class="space-y-4">

                        <input
                            class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                            type="email"
                            placeholder="Email"
                            name="email">

                        <input
                            class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                            type="password"
                            placeholder="Password"
                            name="password">

                        <button
                            class="w-full sm:w-auto px-8 py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-full shadow-md hover:shadow-xl transition-all duration-300">

                            Login

                        </button>

                    </form>

                    <div class="text-center mt-6">

                        <a class="text-blue-700 hover:text-blue-900 underline"
                            href="/owners/create">

                            Create admin account

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
setTimeout(() => {
    const flash = document.getElementById("flashMessage");

    if (flash) {
        flash.style.transition = "opacity 0.5s ease";
        flash.style.opacity = "0";

        setTimeout(() => flash.remove(), 500);
    }
}, 3000);
</script>

<%- include('./partials/footer') %>