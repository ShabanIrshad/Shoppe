<%- include('./partials/header',{acc:profile,active:'account',cart}) %>

<div class="h-screen flex justify-center bg-zinc-100">
    <div class="border flex border-blue-500 h-[100%] w-[80%]">
        <div class="border border-red-500 w-[30%]">
            <div class="w-[150px]  h-[150px] rounded-[50%] bg-white m-auto mt-2 shadow-md">
               <% if (profile.picture) { %>
                    <img class="rounded-[50%]" src="data:image/png;base64,<%= profile.picture.toString('base64') %>" />
                <% } else { %>
                    <img class="rounded-[50%]" src="/images/boy.png" />
                <% } %>
            </div>
            <p class="m-auto text-center mt-3"><%= profile.email %></p>
            <div class="bg-white h-[80px] m-2 shadow-md p-3">
                <p>Hello,</p>
                <p class="text-xl m-2 font-bold"><%= profile.name.toUpperCase() %></p>
            </div>
             <div class="bg-white h-[40px] m-1 shadow-md p-2">
               <h3>ACCOUNT SETTINGS</h3>
            </div>
              <div class="bg-white h-[40px] m-1 shadow-md p-2">
               <h3>PAYMENTS</h3>
            </div>
              <div class="bg-white h-[40px] m-1 shadow-md p-2">
               <h3>MY STUFFS</h3>
            </div>
             <div class="bg-white h-[40px] m-1 shadow-md p-2">
               <h3><%= (isAdmin)?'PRODUCTS':'ORDERS' %></h3>
            </div>
              <div class="bg-white h-[40px] m-1 shadow-md p-2 hover:shadow-lg hover:font-bold">
               <a href="/users/logout"><h3>LOGOUT</h3></a>
            </div>
        </div>
        <div class="border border-pink-500 w-[70%] bg-white p-3">
            <h3 class="h-[10%] text-3xl text-center font-bold">Your <%= (isAdmin)?'Proucts':'Orders' %></h3>
            <div class="w-[100%] h-[90%] flex flex-wrap bg-blue-100 p-2 overflow-x-auto  overflow-y-auto">
                <% if(isAdmin){ %>
                    <% if(!!profile.products){ %>
                        <% profile.products.forEach(function(product){ %>
                        <div class="w-[25%] p-2">
                            <div class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]">
                                <img class="h-[12rem] overflow-hidden" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                    alt="">      
                            </div>
                            <div
                                class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-4 text-[<%= product.textcolor %>]">
                                <div >
                                    <h3 class="font-bold text-xl">
                                        <%= product.name %>
                                    </h3>
                                    <div class="flex" >
                                        <h4 class="font-bold <%= (product.discount>0)? 'line-through':'' %>">₹ <%= product.price %> </h4>
                                        <% if(product.discount>0){ %>
                                            <h4 class="px-2 mx-2 font-bold bg-[#85E695] rounded-md border border-[#20A837] text-[#0B661A]"><%= (product.price-product.discount) %></h4>
                                        <% } %>
                                    </div>
                                    <div>
                                        <% if(!product.rating){%>
                                            <p>0.0⭐</p>
                                        <% }else{ %>
                                            <p><%= product.rating %>⭐</p>
                                        <% } %>
                                        
                                    </div>
                                
                                        
                                    
                                    
                                </div>
                            
                            </div>
                            
                        </div>
                     <% })} %>
                <%  } %>
                    
                
                
                <% if(!isAdmin){ %>
                    <% profile.orders.forEach(function(product){ %>
                        <div class="w-full">
                        <div class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]">
                            <img class="h-[12rem] overflow-hidden" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                alt="">
                               
                               
                        </div>
                        <div
                            class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-4 text-[<%= product.textcolor %>]">
                            <div >
                                <h3 class="font-bold text-xl">
                                    <%= product.name %>
                                </h3>
                                <div class="flex" >
                                     <h4 class="font-bold <%= (product.discount>0)? 'line-through':'' %>">₹ <%= product.price %> </h4>
                                    <% if(product.discount>0){ %>
                                        <h4 class="px-2 mx-2 font-bold bg-[#85E695] rounded-md border border-[#20A837] text-[#0B661A]"><%= (product.price-product.discount) %></h4>
                                    <% } %>
                                </div>
                                <div>
                                    <% if(!product.rating){%>
                                        <p>0.0⭐</p>
                                    <% }else{ %>
                                        <p><%= product.rating %>⭐</p>
                                    <% } %>
                                    
                                </div>
                               
                                    
                                
                                
                            </div>
                           
                        </div>
                        
                    </div>
                <%}) } %>
               
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>