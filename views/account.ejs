<%- include('./partials/header',{acc:profile,active:'account',cart}) %>

<hr>

<div class="min-h-screen bg-zinc-100 py-4">

    <div class="max-w-7xl mx-auto px-4">

        <!-- Main Layout -->
        <div class="flex flex-col lg:flex-row gap-6">

            <!-- Sidebar -->
            <div class="w-full lg:w-[30%]">

                <div class="bg-white rounded-2xl shadow-md p-5">

                    <!-- Profile -->
                    <div class="flex flex-col items-center">

                        <div class="w-32 h-32 rounded-full overflow-hidden bg-gray-100 shadow">

                            <% if (profile.picture) { %>
                                <img class="w-full h-full object-cover"
                                src="data:image/png;base64,<%= profile.picture.toString('base64') %>" />
                            <% } else { %>
                                <img class="w-full h-full object-cover"
                                src="/images/boy.png" />
                            <% } %>

                        </div>

                        <p class="mt-4 text-sm text-gray-600 break-all text-center">
                            <%= profile.email %>
                        </p>

                    </div>

                    <!-- Greeting -->
                    <div class="bg-zinc-50 rounded-xl shadow-sm p-4 mt-6">

                        <p class="text-gray-500 text-sm">Hello,</p>

                        <p class="text-xl font-bold mt-1">
                            <%= profile.name.toUpperCase() %>
                        </p>

                    </div>

                    <!-- Menu -->
                    <div class="mt-6 space-y-2">

                        <div class="bg-white border rounded-lg p-3 hover:bg-blue-50 transition cursor-pointer">
                            ACCOUNT SETTINGS
                        </div>

                        <div class="bg-white border rounded-lg p-3 hover:bg-blue-50 transition cursor-pointer">
                            PAYMENTS
                        </div>

                        <div class="bg-white border rounded-lg p-3 hover:bg-blue-50 transition cursor-pointer">
                            MY STUFFS
                        </div>

                        <div class="bg-white border rounded-lg p-3 hover:bg-blue-50 transition cursor-pointer">
                            <%= (isAdmin)?'PRODUCTS':'ORDERS' %>
                        </div>

                        <a href="/users/logout"
                           class="block bg-red-50 text-red-600 border border-red-200 rounded-lg p-3 hover:bg-red-100 transition font-medium">
                            LOGOUT
                        </a>

                    </div>

                </div>

            </div>

            <!-- Orders Section -->
            <div class="w-full lg:w-[70%] bg-white rounded-2xl shadow-md p-5">

                <h3 class="text-2xl md:text-3xl text-center font-bold mb-6">
                    Your <%= (isAdmin)?'Products':'Orders' %>
                </h3>

                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">

                    <% if(isAdmin){ %>

                        <% if(!!profile.products){ %>

                            <% profile.products.forEach(function(product){ %>

                                <div class="rounded-xl overflow-hidden shadow hover:shadow-xl transition">

                                    <div class="aspect-square flex items-center justify-center bg-[<%= product.bgcolor %>] p-4">

                                        <img class="max-h-44 object-contain"
                                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                        alt="">

                                    </div>

                                    <div class="bg-[<%= product.panelcolor %>] text-[<%= product.textcolor %>] p-3">

                                        <h3 class="font-bold text-lg truncate">
                                            <%= product.name %>
                                        </h3>

                                        <div class="flex items-center flex-wrap gap-2 mt-2">

                                            <h4 class="font-bold <%= (product.discount>0)? 'line-through':'' %>">
                                                ₹ <%= product.price %>
                                            </h4>

                                            <% if(product.discount>0){ %>

                                                <span class="px-2 py-1 text-sm font-bold bg-[#85E695] rounded-md border border-[#20A837] text-[#0B661A]">
                                                    <%= (product.price-product.discount) %>
                                                </span>

                                            <% } %>

                                        </div>

                                        <div class="mt-2">

                                            <% if(!product.rating){ %>

                                                <p>0.0⭐</p>

                                            <% } else { %>

                                                <p><%= product.rating %>⭐</p>

                                            <% } %>

                                        </div>

                                    </div>

                                </div>

                            <% }) %>

                        <% } %>

                    <% } %>

                    <% if(!isAdmin){ %>

                        <% profile.orders.forEach(function(product){ %>

                            <div class="rounded-xl overflow-hidden shadow hover:shadow-xl transition">

                                <div class="aspect-square flex items-center justify-center bg-[<%= product.bgcolor %>] p-4">

                                    <img class="max-h-44 object-contain"
                                    src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                    alt="">

                                </div>

                                <div class="bg-[<%= product.panelcolor %>] text-[<%= product.textcolor %>] p-3">

                                    <h3 class="font-bold text-lg truncate">
                                        <%= product.name %>
                                    </h3>

                                    <div class="flex items-center flex-wrap gap-2 mt-2">

                                        <h4 class="font-bold <%= (product.discount>0)? 'line-through':'' %>">
                                            ₹ <%= product.price %>
                                        </h4>

                                        <% if(product.discount>0){ %>

                                            <span class="px-2 py-1 text-sm font-bold bg-[#85E695] rounded-md border border-[#20A837] text-[#0B661A]">
                                                <%= (product.price-product.discount) %>
                                            </span>

                                        <% } %>

                                    </div>

                                    <div class="mt-2">

                                        <% if(!product.rating){ %>

                                            <p>0.0⭐</p>

                                        <% } else { %>

                                            <p><%= product.rating %>⭐</p>

                                        <% } %>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>