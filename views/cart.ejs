<%- include('./partials/header') %>
    <% user.cart.forEach((item)=>{ %>
        <hr>
         <div class="w-full h-[50%] flex items-start px-20 py-10 gap-5">
        <div class="w-60  rounded-md overflow-hidden">
            <div class="w-full flex justify-center items-center h-48 bg-[<%= item.bgcolor %>]">
                <img class="h-[10rem]" src="data:image/png;base64,<%= item.image.toString('base64') %>" alt="ProductImage"/>
            </div>
            <div class="w-full flex justify-between px-5 py-4 bg-black">
                <h3 class="text-2xl text-white"><%= item.name %></h3>
                <div class="flex items-center gap-2">
                    <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-add-line"></i>
                    <div class="px-2 py-1 rounded-md bg-white text-black">01</div>
                    <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-subtract-line"></i>
                </div>
            </div>
           
        </div>
        <div class="w-[70%]">
            <h3 class="text-xl">Price Breakdown</h3>
            <div class="px-10 mt-5">
                <div class="flex mt-2">
                    <h4 class="w-1/3">Total MRP</h4>
                    <h4>₹ <%= item.price %></h4>
                </div>
                <div class="flex mt-2">
                    <h4 class="w-1/3">Discount on MRP</h4>
                    <h4>₹ <%= Number(item.discount) %></h4>
                </div>
                 <div class="flex mt-2">
                    <h4 class="w-1/3">Online Processing Fee</h4>
                    <h4>₹ 0</h4>
                </div>
                 <div class="flex mt-2">
                    <h4 class="w-1/3">Other Charges</h4>
                    <h4>₹ 0</h4>
                </div>
               
                 <div class="flex mt-2 font-bold">
                    <h4 class="w-1/3">Payable Amount</h4>
                    <h4>₹ <%= (item.price-item.discount) %></h4>
                </div>
            </div>
             <div class="w-full h-[1px] bg-black mt-10"></div>
           
        </div>
       
           
    </div>
    
    <% }) %>
    <div class="flex justify-end mb-10">
        <div class="w-[40%] mr-20 p-10">
            <div class="flex justify-between">
                <h3 class="font-bold text-xl">Platform Fee</h3>
                <h3 class="font-semibold text-xl">₹ 20</h3>
            </div>
             <div class="flex justify-between">
                <h3 class="font-bold text-xl">Shipping Fee</h3>
                <h3 class="font-semibold text-xl">FREE</h3>
            </div>
            <div class="flex justify-between">
                <h3 class="font-bold text-xl">TAX(18%)</h3>
                <h3 class="font-semibold text-xl">522</h3>
            </div>
            <hr>
             <div class="flex justify-between">
                <h3 class="font-bold text-xl">Total Amount</h3>
                <h3 class="font-semibold text-xl text-green-600">₹ <%=total%></h3>
            </div>
             <form action="" class=" flex justify-center mt-5">
                 <button class="text-white bg-blue-400 p-5 font-bold text-2xl rounded-lg shadow-md hover:shadow-xl 
               transition-shadow duration-300">Order Now</button>
             </form>
         </div>
         
    </div>
   
    <%- include('./partials/footer') %>