
<%- include('./partials/header') %>

            <div class="w-full h-screen flex justify-center items-center px-20 ">
                <div class="w-1/2 flex items-center bg-blue-100 justify-center h-screen">
                    <div class="w-full px-32">
                        <a class="underline text-blue-700" href="/">Back</a>
                        <h3 class="text-4xl">welcome to <span class="text-blue-400 font-semibold">Shoppe</span></h3>
                        <h4 class="text-2xl mb-5">create Admin account</h4>
                        <form autocomplete="off" action="/owners/create" method="post" enctype="multipart/form-data">
                            <input
                                class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="text" placeholder="Full Name" name="name">
                            <input
                                class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="email" placeholder="Email" name="email">
                            <input
                                class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="password" placeholder="Password" name="password">
                            <input
                                class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="text" placeholder="GST No" name="gstin">
                            <input type="file" name="avatar" />  
                            <input class="px-5 rounded-full py-3 mt-2 bg-blue-500 text-white" type="submit"
                                value="Create Admin">
                        </form>
                    </div>
                </div>
              
            </div>
          
            <%- include('./partials/footer') %>