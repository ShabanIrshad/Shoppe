<%- include('./partials/header',{acc:profile,active:'shop',cart}) %>

<% if(success.length>0){ %>
<div id="flashMessage"
    class="fixed top-20 left-1/2 -translate-x-1/2 bg-blue-500 text-white px-5 py-3 rounded-lg shadow-lg z-50">
    <%= success %>
</div>
<% } %>

<div class="max-w-7xl mx-auto px-4 py-5">

    <!-- Mobile Filter Button -->
    <div class="lg:hidden mb-4">
        <button id="filterBtn"
            class="w-full bg-white border rounded-xl px-4 py-3 shadow flex items-center justify-between">
            <span class="font-semibold">Filters & Categories</span>
            <i class="ri-menu-line text-xl"></i>
        </button>
    </div>

    <div class="flex flex-col lg:flex-row gap-6">

        <!-- Sidebar -->
        <aside id="sidebar"
            class="hidden lg:block lg:w-64 bg-white rounded-2xl shadow-md p-5 h-fit">

            <!-- Sort -->
            <div>
                <h3 class="font-bold mb-3">Sort By</h3>

                <form action="/sortby" method="get">
                    <select
                        class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-400"
                        name="sortby"
                        onchange="this.form.submit()">

                        <option value="popular">Select</option>
                        <option value="popular">Popular</option>
                        <option value="newest">Newest</option>

                    </select>
                </form>
            </div>

            <hr class="my-6">

            <!-- Categories -->
            <div class="space-y-3">

                <% if(owner){ %>
                    <a href="/products/create"
                       class="block hover:text-blue-500">
                        Edit Products
                    </a>
                <% } %>

                <a href="/products/newcollection"
                   class="block hover:text-blue-500">
                    New Collection
                </a>

                <a href="/shop"
                   class="block hover:text-blue-500">
                    All Products
                </a>

                <a href="/products/discounted"
                   class="block hover:text-blue-500">
                    Discounted Products
                </a>

            </div>

            <hr class="my-6">

            <!-- Filters -->
            <div>

                <h3 class="font-bold mb-3">Filter By</h3>

                <div class="space-y-3">

                    <a href="/available"
                       class="block hover:text-blue-500">
                        Availability
                    </a>

                    <a href="/discounted"
                       class="block hover:text-blue-500">
                        Discount
                    </a>

                </div>

            </div>

        </aside>

        <!-- Mobile Sidebar -->
        <div id="mobileSidebar"
            class="hidden lg:hidden bg-white rounded-2xl shadow-md p-5 mb-4">

            <div class="mb-5">

                <h3 class="font-bold mb-3">Sort By</h3>

                <form action="/sortby" method="get">
                    <select
                        class="w-full border rounded-lg px-3 py-2"
                        name="sortby"
                        onchange="this.form.submit()">

                        <option value="popular">Select</option>
                        <option value="popular">Popular</option>
                        <option value="newest">Newest</option>

                    </select>
                </form>

            </div>

            <div class="space-y-3">

                <% if(owner){ %>
                    <a href="/products/create" class="block">Edit Products</a>
                <% } %>

                <a href="/products/newcollection" class="block">New Collection</a>
                <a href="/shop" class="block">All Products</a>
                <a href="/products/discounted" class="block">Discounted Products</a>

                <hr>

                <a href="/available" class="block">Availability</a>
                <a href="/discounted" class="block">Discount</a>

            </div>

        </div>

        <!-- Products -->
        <main class="flex-1">

            <% if(products.length==0){ %>

                <div class="bg-white rounded-2xl shadow-md p-10 text-center">
                    <h3 class="text-3xl font-bold">
                        No Products Added Yet!
                    </h3>
                </div>

            <% } %>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 <%= products.length==0?'hidden':'' %>">

                <% products.forEach(function(product){ %>

                <div
                    class="bg-white rounded-2xl overflow-hidden shadow hover:shadow-xl transition duration-300">

                    <!-- Image -->
                    <div
                        class="relative aspect-square flex items-center justify-center bg-[<%= product.bgcolor %>] p-4">

                        <img
                            class="max-h-44 object-contain"
                            src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                            alt="">

                        <% if(owner){ %>

                        <span
                            class="absolute top-3 right-3 bg-white px-2 py-1 rounded-full text-xs font-bold shadow <%= product.stock<=1 ? 'text-red-500':'text-black' %>">

                            <%= product.stock %>

                        </span>

                        <% } %>

                    </div>

                    <!-- Product Info -->
                    <div
                        class="bg-[<%= product.panelcolor %>] text-[<%= product.textcolor %>] p-4">

                        <div class="flex justify-between items-start">

                            <div>

                                <h3 class="font-bold text-lg leading-tight">
                                    <%= product.name %>
                                </h3>

                                <div class="flex flex-wrap items-center gap-2 mt-2">

                                    <span
                                        class="font-bold <%= product.discount>0 ? 'line-through':'' %>">

                                        ₹ <%= product.price %>

                                    </span>

                                    <% if(product.discount>0){ %>

                                    <span
                                        class="px-2 py-1 text-sm font-bold bg-[#85E695] rounded-md border border-[#20A837] text-[#0B661A]">

                                        <%= product.price-product.discount %>

                                    </span>

                                    <% } %>

                                </div>

                                <p class="mt-2 text-sm">
                                    <%= product.rating || '0.0' %> ⭐
                                </p>

                            </div>

                            <a
                                href="/addtocart/<%=product._id%>"
                                class="w-9 h-9 flex items-center justify-center rounded-full bg-white text-black hover:scale-110 transition">

                                <i class="ri-add-line"></i>

                            </a>

                        </div>

                    </div>

                    <% if(owner){ %>

                    <div class="bg-red-400 hover:bg-red-500 transition">

                        <a
                            href="/products/delete/<%= product._id %>"
                            class="block text-center py-2 text-white font-medium">

                            Delete

                        </a>

                    </div>

                    <% } %>

                </div>

                <% }) %>

            </div>

        </main>

    </div>

</div>

<script>
setTimeout(() => {
    const flash = document.getElementById('flashMessage');
    if (flash) {
        flash.style.transition = 'opacity 0.5s ease';
        flash.style.opacity = '0';
        setTimeout(() => flash.remove(), 500);
    }
}, 3000);

const filterBtn = document.getElementById("filterBtn");
const mobileSidebar = document.getElementById("mobileSidebar");

if(filterBtn){
    filterBtn.addEventListener("click", () => {
        mobileSidebar.classList.toggle("hidden");
    });
}
</script>

<%- include('./partials/footer') %>